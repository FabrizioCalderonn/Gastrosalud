generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id          String   @id @default(cuid())
  // Calendar day the appointment falls on, stored at UTC midnight.
  date        DateTime
  // Slot start expressed as minutes after midnight (e.g. 8:30am = 510).
  minutes     Int
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientName String
  phone       String
  dui         String?
  // Optional — staff-created appointments may not have one. Automated emails
  // (confirm/cancel/reminder) are skipped when null.
  email       String?
  // "primera" | "seguimiento"
  visitType   String
  // "pendiente" | "confirmada" | "cancelada" — drives automated emails, see src/lib/email.ts
  status      String   @default("pendiente")
  // Separate attendance checkmark: "pendiente" | "visto" | "cancelado" | "reprogramado" — no email side effects.
  attendanceStatus String @default("pendiente")
  notes       String?
  // Token for the patient's self-service link (/mi-cita/[token]). Nullable
  // because appointments created before this field existed have no token.
  manageToken String?  @unique
  // Set once the 24h-before reminder email has been sent, to avoid duplicates.
  reminderSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, minutes])
  @@index([date])
  @@index([status])
  @@index([patientId])
}

enum Role {
  doctora
  laboratorista
  recepcion
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         Role     @default(doctora)
  createdAt    DateTime @default(now())
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  phone     String
  dui       String?  @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments    Appointment[]
  notes           PatientNote[]
  labResults      LabResult[]
  clinicalRecords ClinicalRecordEntry[]

  @@index([phone])
  @@index([name])
}

model PatientNote {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  content    String
  authorName String
  authorRole Role
  createdAt  DateTime @default(now())

  @@index([patientId])
}

// Doctora-only. Enforced in the server component / route handler that reads
// this model — must never be queried on behalf of another role.
model ClinicalRecordEntry {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  content    String
  authorName String
  createdAt  DateTime @default(now())

  @@index([patientId])
}

model LabResult {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String   @default("application/pdf")
  fileSize   Int
  fileData   Bytes
  label      String?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([patientId])
}

// One row per working time range. A day with no rows is closed.
model WorkingHoursRange {
  id           String @id @default(cuid())
  // 0 = Sunday ... 6 = Saturday
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int

  @@index([dayOfWeek])
}

// A period the clinic is unavailable, set by the admin (vacations, a blocked
// afternoon, etc). startDate/endDate are inclusive calendar days. When
// startMinutes/endMinutes are null the whole day(s) are blocked; otherwise only
// that time window is blocked on each day in the range.
model BlockedPeriod {
  id           String   @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  startMinutes Int?
  endMinutes   Int?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([startDate, endDate])
}

// Singleton row (id is always 1) holding schedule-wide settings.
model ScheduleSettings {
  id                  Int @id @default(1)
  slotDurationMinutes Int @default(30)
  // Minimum notice required to book/reschedule a slot, in minutes before its start.
  minLeadMinutes      Int @default(60)
}

// Singleton row (id is always 1) holding the editable subject/body used for
// appointment confirm/cancel emails. Bodies support placeholders
// ({{nombre}}, {{fecha}}, {{hora}}) substituted at send time.
model EmailTemplate {
  id             Int    @id @default(1)
  confirmSubject String @default("Tu cita en GastroSalud fue confirmada")
  confirmBody    String @default("Hola {{nombre}},\n\nTu cita en GastroSalud quedó confirmada para el {{fecha}} a las {{hora}}.\n\n¡Te esperamos!")
  cancelSubject  String @default("Tu cita en GastroSalud fue cancelada")
  cancelBody     String @default("Hola {{nombre}},\n\nLamentamos informarte que tu cita para el {{fecha}} a las {{hora}} fue cancelada.\n\nPara reprogramar, contáctanos o agenda de nuevo en el sitio web.")
  reminderSubject String @default("Recordatorio: tu cita en GastroSalud es mañana")
  reminderBody    String @default("Hola {{nombre}},\n\nTe recordamos tu cita en GastroSalud mañana {{fecha}} a las {{hora}}.\n\n¡Te esperamos!")
  // Sent when the PATIENT cancels their own appointment via /mi-cita/[token].
  // cancelSubject/cancelBody above are used when the clinic cancels from /admin.
  patientCancelSubject String @default("Tu cita en GastroSalud fue cancelada")
  patientCancelBody    String @default("Hola {{nombre}},\n\nConfirmamos que cancelaste tu cita del {{fecha}} a las {{hora}}.\n\nSi deseas agendar una nueva, visita el sitio web cuando gustes.")
}
